{
  "name": "lfttdo",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:css": "stylelint \"src/**/*.css\" \"!src/theme/tokens.css\" \"!src/theme/presets.css\"",
    "tauri": "tauri",
    "dev:astryx": "npm --prefix astryx-ui run dev",
    "build:astryx": "npm --prefix astryx-ui run build",
    "test:edition": "node --test scripts/astryx-ui-copy.check.mjs scripts/astryx-edition-config.check.mjs",
    "tauri:astryx": "tauri dev --config src-tauri/tauri.astryx.conf.json",
    "tauri:astryx:build": "tauri build --config src-tauri/tauri.astryx.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
